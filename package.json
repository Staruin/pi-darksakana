{
  "name": "pi-darksakana",
  "version": "0.2.0",
  "description": "Two-theme Pi TUI pack: violet-cyberdeck and dark-sakana themes plus their header, footer, matrix and spinner extensions.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-theme",
    "pi-extension",
    "tui",
    "theme",
    "sakana",
    "cyberdeck"
  ],
  "files": [
    "themes",
    "extensions",
    "config",
    "licenses",
    "scripts",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "smoke": "node --experimental-strip-types scripts/smoke-render.mjs",
    "preview": "node scripts/preview.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "themes": [
      "./themes/*.json"
    ],
    "extensions": [
      "./extensions/darksakana/footer-info.ts",
      "./extensions/darksakana/startup-header.ts",
      "./extensions/cyberdeck/header/index.ts",
      "./extensions/cyberdeck/matrix/index.ts",
      "./extensions/cyberdeck/zentui/index.ts",
      "./extensions/cyberdeck/claude-shimmer/index.ts"
    ]
  }
}